"""On-prem Active Directory (LDAP) identity provider.

Supports one or more directories (separate AD domains/forests). Directory 1 is
the unsuffixed ``LDAP_*`` config; add a second domain with the ``LDAP_*_2`` set.
Login tries each directory in order until one authenticates; group lookups for
the admin UI span every configured directory.

Flow on /auth/ldap/login, per directory until one succeeds:
    1. Service-account bind to look up the user's distinguishedName,
       objectGUID, userPrincipalName, displayName, mail.
    2. Re-bind as the user using their DN + supplied password. A successful
       bind is the authentication signal.
    3. Service-account search for all groups the user belongs to —
       *transitive*, using AD's `LDAP_MATCHING_RULE_IN_CHAIN` matching rule
       (OID 1.2.840.113556.1.4.1941) so nested group memberships count.
    4. Convert each group's objectGUID (binary, little-endian) into the
       canonical UUID string form. Those strings match `Role.ad_group_id`.
    5. Just-in-time provision / refresh the local User row, set its roles
       from the matching Role rows.

Configuration (in backend/.env):
    LDAP_URI=ldaps://dc.contoso.local:636
    LDAP_BIND_DN=CN=svc-automation,OU=Service Accounts,DC=contoso,DC=local
    LDAP_BIND_PASSWORD=__SET_FROM_VAULT__
    LDAP_USER_SEARCH_BASE=DC=contoso,DC=local
    LDAP_USER_FILTER=(&(objectCategory=person)(|(sAMAccountName={username})(userPrincipalName={username})))
    LDAP_GROUP_SEARCH_BASE=DC=contoso,DC=local
    # optional second domain (same forest → reuses LDAP_BIND_DN/PASSWORD)
    LDAP_URI_2=ldaps://dc.child.contoso.local:636
    LDAP_USER_SEARCH_BASE_2=DC=child,DC=contoso,DC=local
    LDAP_GROUP_SEARCH_BASE_2=DC=child,DC=contoso,DC=local
"""
from __future__ import annotations

import logging
import ssl
from dataclasses import dataclass, field
from datetime import datetime
from uuid import UUID

import structlog
from flask import current_app
from ldap3 import ALL, SUBTREE, Connection, Server, Tls
from ldap3.core.exceptions import (
    LDAPException,
    LDAPInvalidCredentialsResult,
    LDAPSocketReceiveError,
)
from ldap3.utils.conv import escape_filter_chars

from ..extensions import db
from ..models import Role, User
from ..models._mixins import migration_safe_value
from ..utils.errors import AuthError
from . import settings as settings_svc

log = logging.getLogger(__name__)
# stdlib `extra=` kwargs don't render through the structlog ProcessorFormatter
# (see backend/CLAUDE.md); use a structlog logger for diagnostic fields we
# actually want to see in output (group/role discovery troubleshooting).
slog = structlog.get_logger(__name__)

_DEFAULT_USER_FILTER = (
    "(&(objectCategory=person)(|(sAMAccountName={username})(userPrincipalName={username})))"
)

# Seconds to wait for the *user* bind to come back. This is the one bind an MFA
# push suspends — the directory holds it open until the person acknowledges the
# prompt on their phone — so it needs far more headroom than the 5s connect
# budget every other operation inherits (see _build_server).
# Each login waiting on a push occupies a server thread for up to this long, so
# it can't grow without also growing the gunicorn/waitress thread count.
_USER_BIND_TIMEOUT_SECONDS = 60


@dataclass(frozen=True)
class LdapPrincipal:
    upn: str
    display_name: str
    object_guid: str
    group_ids: set[str] = field(default_factory=set)
    # Raw value of the AD ``c`` attribute (not ``co``), exactly as read from
    # the directory. Normalization into a portal country code is the country
    # map's job — see settings.resolve_country_mapping().
    country_raw: str | None = None


@dataclass(frozen=True)
class LdapDirectory:
    """One AD domain/forest the platform can authenticate against."""

    name: str
    uri: str
    bind_dn: str
    bind_password: str
    user_base: str
    group_base: str
    user_filter: str
    tls_insecure: bool


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def _guid_to_str(raw: bytes) -> str:
    """Convert an AD binary objectGUID (16 bytes, little-endian) to canonical UUID."""
    return str(UUID(bytes_le=raw))


def _base_to_domain(base: str) -> str:
    """"DC=contoso,DC=local" → "contoso.local"."""
    parts = [p[3:] for p in (base or "").split(",") if p.upper().startswith("DC=")]
    return ".".join(parts) or "ldap.local"


def _as_bool(value, default: bool) -> bool:
    if value is None or value == "":
        return default
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in {"1", "true", "yes", "on"}


def _load_directories(cfg) -> list[LdapDirectory]:
    """Build the ordered list of configured directories from app config.

    Directory 1 is the unsuffixed LDAP_* config (always present when AUTH_MODE=
    ldap). Directory 2 is the LDAP_*_2 set, included only when LDAP_URI_2 is set.
    USER_FILTER / TLS_INSECURE for directory 2 fall back to directory 1.
    """
    primary_filter = cfg.get("LDAP_USER_FILTER", "") or _DEFAULT_USER_FILTER
    primary_tls = bool(cfg.get("LDAP_TLS_INSECURE", False))

    directories: list[LdapDirectory] = []

    uri1 = (cfg.get("LDAP_URI", "") or "").strip()
    base1 = (cfg.get("LDAP_USER_SEARCH_BASE", "") or "").strip()
    if not uri1:
        raise AuthError("LDAP_URI is not configured")
    if not base1:
        raise AuthError("LDAP_USER_SEARCH_BASE is not configured")
    directories.append(LdapDirectory(
        name=_base_to_domain(base1),
        uri=uri1,
        bind_dn=(cfg.get("LDAP_BIND_DN", "") or "").strip(),
        bind_password=cfg.get("LDAP_BIND_PASSWORD", "") or "",
        user_base=base1,
        group_base=(cfg.get("LDAP_GROUP_SEARCH_BASE", "") or "").strip() or base1,
        user_filter=primary_filter,
        tls_insecure=primary_tls,
    ))

    uri2 = (cfg.get("LDAP_URI_2", "") or "").strip()
    if uri2:
        base2 = (cfg.get("LDAP_USER_SEARCH_BASE_2", "") or "").strip()
        if not base2:
            raise AuthError("LDAP_USER_SEARCH_BASE_2 is required when LDAP_URI_2 is set")
        # Same-forest: the directory-1 service account can bind to the second
        # domain too, so bind creds fall back to directory 1 when left blank.
        directories.append(LdapDirectory(
            name=_base_to_domain(base2),
            uri=uri2,
            bind_dn=(cfg.get("LDAP_BIND_DN_2", "") or "").strip()
                    or (cfg.get("LDAP_BIND_DN", "") or "").strip(),
            bind_password=cfg.get("LDAP_BIND_PASSWORD_2", "") or cfg.get("LDAP_BIND_PASSWORD", "") or "",
            user_base=base2,
            group_base=(cfg.get("LDAP_GROUP_SEARCH_BASE_2", "") or "").strip() or base2,
            user_filter=cfg.get("LDAP_USER_FILTER_2", "") or primary_filter,
            tls_insecure=_as_bool(cfg.get("LDAP_TLS_INSECURE_2", ""), primary_tls),
        ))

    return directories


def _build_server(directory: LdapDirectory) -> Server:
    """Build the ldap3 Server for a directory.

    Beware: `connect_timeout` is not only a connect timeout. ldap3 applies it
    with socket.settimeout(), which bounds recv() as well, and only resets it
    when Connection(receive_timeout=...) is passed (ldap3 strategy/base.py
    `_open_socket`). So this 5s silently becomes the *response* deadline for
    every operation on a connection that doesn't override it — which is what
    made an MFA-gated bind fail unconditionally, since no one can acknowledge a
    push that fast. The user bind overrides it; see _USER_BIND_TIMEOUT_SECONDS.
    """
    use_ssl = directory.uri.lower().startswith("ldaps://")
    tls = None
    if use_ssl:
        # In dev (Samba) the DC cert is usually self-signed; switch validation off via env.
        validate = ssl.CERT_NONE if directory.tls_insecure else ssl.CERT_REQUIRED
        tls = Tls(validate=validate, version=ssl.PROTOCOL_TLS_CLIENT)
    return Server(directory.uri, get_info=ALL, use_ssl=use_ssl, tls=tls, connect_timeout=5)


def _service_connection(directory: LdapDirectory) -> Connection:
    if not directory.bind_dn or not directory.bind_password:
        raise AuthError(
            f"LDAP service account for directory '{directory.name}' is not configured"
        )
    try:
        return Connection(
            _build_server(directory), user=directory.bind_dn, password=directory.bind_password,
            auto_bind=True, raise_exceptions=True,
        )
    except LDAPException as e:
        # structlog logger, not the stdlib one: stdlib `extra=` kwargs don't
        # render through the ProcessorFormatter, so the reason this bind failed
        # (timeout vs. bad password vs. TLS) was being swallowed entirely.
        slog.error("ldap_service_bind_failed", dir=directory.name, err=str(e)[:200])
        raise AuthError(
            f"LDAP service bind failed for directory '{directory.name}'; check its "
            "LDAP_BIND_DN / LDAP_BIND_PASSWORD"
        ) from e


# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------
def authenticate(username: str, password: str) -> LdapPrincipal:
    """Authenticate a user against each configured directory in turn.

    Returns the principal from the first directory where the user exists and the
    password binds. Raises AuthError on bad credentials or if no directory is
    reachable.
    """
    if not username or not password:
        raise AuthError("username and password are required")

    directories = _load_directories(current_app.config)
    reachable = False
    for directory in directories:
        try:
            service = _service_connection(directory)
        except AuthError as e:
            # A misconfigured/unreachable directory must not block the others.
            log.warning("ldap_directory_unavailable",
                        extra={"dir": directory.name, "err": str(e)})
            continue
        reachable = True
        try:
            principal = _find_and_bind(directory, service, username, password)
        finally:
            try:
                service.unbind()
            except Exception:  # noqa: BLE001
                pass
        if principal is not None:
            return principal

    if not reachable:
        raise AuthError("No LDAP directory is reachable; check the service bind credentials")
    raise AuthError("Invalid credentials")


def _find_and_bind(directory: LdapDirectory, service: Connection,
                   username: str, password: str) -> LdapPrincipal | None:
    """Look up + authenticate the user in one directory.

    Returns the principal on success, or None when the user is not in this
    directory or the password did not bind (so the caller can try the next one).
    Raises AuthError for a definitive match that must stop the search (disabled).
    """
    user_filter = directory.user_filter.format(username=escape_filter_chars(username))
    try:
        service.search(
            search_base=directory.user_base,
            search_filter=user_filter,
            search_scope=SUBTREE,
            attributes=[
                "distinguishedName", "sAMAccountName", "userPrincipalName",
                "displayName", "mail", "objectGUID", "userAccountControl",
                # The AD country attribute we read is `c`, not `co`. Anything
                # naming this `co` (older docstrings/params) is a misnomer —
                # `c` is the attribute whose value the country map keys on.
                "c",
            ],
        )
    except LDAPException as e:
        # e.g. a bad base DN — don't let one directory's issue block the others.
        log.warning("ldap_user_search_failed",
                    extra={"dir": directory.name, "err": str(e)})
        return None
    if not service.entries:
        return None  # not in this directory — try the next
    entry = service.entries[0]
    user_dn = str(entry.distinguishedName.value) if entry.distinguishedName else None
    if not user_dn:
        return None

    # Reject disabled accounts (bit 0x2 of userAccountControl).
    try:
        if int(entry.userAccountControl.value) & 0x2:
            raise AuthError("Account is disabled")
    except (AttributeError, TypeError, ValueError):
        pass

    # Bind AS THE USER. This is the authentication. When the directory enforces
    # MFA this is the call that blocks on the push, so it gets its own, longer
    # receive budget rather than the one sized for service searches.
    try:
        user_conn = Connection(_build_server(directory), user=user_dn, password=password,
                               auto_bind=True,
                               receive_timeout=_USER_BIND_TIMEOUT_SECONDS)
        user_conn.unbind()
    except LDAPInvalidCredentialsResult:
        return None  # found, but wrong password — allow other directories to try
    except LDAPSocketReceiveError as e:
        # The user exists here and the directory simply never answered — almost
        # always an unacknowledged MFA push. Raise instead of returning None:
        # falling through to the next directory would both mislabel this as
        # "Invalid credentials" and fire a second push at the same person.
        slog.warning("ldap_user_bind_timeout", dir=directory.name,
                     timeout_seconds=_USER_BIND_TIMEOUT_SECONDS, err=str(e)[:200])
        raise AuthError(
            "Authentication timed out waiting for the directory to respond. If "
            "multi-factor authentication is enabled, approve the prompt and try "
            "again."
        ) from e
    except LDAPException as e:
        slog.warning("ldap_user_bind_failed", dir=directory.name, err=str(e)[:200])
        return None

    # Resolve transitive group memberships using AD's chain rule. A failure here
    # must not deny a user who already authenticated — fall back to no groups.
    # LDAP_GROUP_SEARCH_BASE can be semicolon-delimited for multiple OUs.
    group_ids: set[str] = set()
    group_filter = f"(member:1.2.840.113556.1.4.1941:={escape_filter_chars(user_dn)})"
    search_bases = [b.strip() for b in (directory.group_base or "").split(";") if b.strip()]
    all_group_names: list[str] = []

    for search_base in search_bases:
        try:
            service.search(
                search_base=search_base,
                search_filter=group_filter,
                search_scope=SUBTREE,
                attributes=["objectGUID", "cn", "sAMAccountName"],
            )
            for g in service.entries:
                try:
                    group_ids.add(_guid_to_str(g.objectGUID.raw_values[0]))
                    cn = g.attributes.get("cn", ["?"])[0] if hasattr(g, "attributes") else "?"
                    all_group_names.append(cn)
                except (AttributeError, IndexError, ValueError):
                    continue
        except LDAPException as e:
            slog.warning(
                "ldap_group_search_failed",
                dir=directory.name,
                search_base=search_base,
                err=str(e),
            )

    slog.debug(
        "ldap_group_search",
        search_bases=search_bases,
        search_filter=group_filter,
        results_count=len(group_ids),
        group_names=all_group_names,
    )

    upn = (
        (entry.userPrincipalName.value if entry.userPrincipalName else None)
        or (entry.mail.value if entry.mail else None)
        or f"{entry.sAMAccountName.value}@{directory.name}"
    )
    display = (entry.displayName.value if entry.displayName else None) or upn or username
    guid_str = _guid_to_str(entry.objectGUID.raw_values[0])
    try:
        country_raw = entry.c.value if entry.c else None
    except (AttributeError, TypeError, ValueError):
        country_raw = None

    return LdapPrincipal(
        upn=str(upn).lower(),
        display_name=str(display),
        object_guid=guid_str,
        group_ids=group_ids,
        country_raw=str(country_raw) if country_raw is not None else None,
    )


def provision_or_update_user(principal: LdapPrincipal) -> User:
    """Just-in-time provision / refresh a local User from an LDAP principal."""
    # Match by AD object GUID first (stable), then by email/UPN as fallback.
    user = User.query.filter_by(ad_object_id=principal.object_guid).first()
    if user is None:
        user = User.query.filter_by(email=principal.upn).first()
    is_new = user is None

    # Resolve country BEFORE mutating the row. A real mapped AD value always
    # wins; a blank/unmapped one must not clobber a country support assigned
    # by hand, but must still seed a never-set one from the default.
    # migration_safe_value() can roll the session back on an unmigrated DB, so
    # it must run before any pending change exists - and only when needed.
    mapped, default_code = settings_svc.resolve_country_mapping(principal.country_raw)
    if mapped is not None:
        new_country, write_country = mapped, True
    elif is_new:
        # `default_code or None` keeps NULL the single canonical "unset".
        new_country, write_country = (default_code or None), True
    else:
        current = migration_safe_value(user, "country", "country")
        # `not current` treats legacy "" the same as NULL, so those rows
        # self-heal to the default on the next login.
        new_country, write_country = (default_code or None), not current

    if is_new:
        user = User(
            email=principal.upn,
            display_name=principal.display_name,
            identity_source="ldap",
            ad_object_id=principal.object_guid,
            is_active=True,
        )
        db.session.add(user)
        db.session.flush()
    else:
        user.identity_source = "ldap"
        user.ad_object_id = principal.object_guid
        user.email = principal.upn
        user.display_name = principal.display_name
        if not user.is_active:
            raise AuthError("User is disabled in the platform")

    if write_country:
        user.country = new_country

    if principal.group_ids:
        matched = Role.query.filter(Role.ad_group_id.in_(principal.group_ids)).all()
    else:
        matched = []
    user.roles = matched
    user.last_login_at = datetime.utcnow()
    db.session.flush()
    slog.info(
        "ldap_login_role_mapping",
        user=principal.upn,
        groups_found=len(principal.group_ids),
        roles_mapped=[role.name for role in matched],
        roles_count=len(matched),
    )
    return user


def search_groups(query: str, limit: int = 25) -> list[dict]:
    """Search AD groups by display-name prefix across every directory.

    Returns Graph-compatible dicts, deduped by objectGUID, capped at `limit`.
    """
    directories = _load_directories(current_app.config)
    safe = escape_filter_chars(query)
    ldap_filter = f"(&(objectClass=group)(|(cn={safe}*)(sAMAccountName={safe}*)))"

    results: list[dict] = []
    seen: set[str] = set()
    for directory in directories:
        if len(results) >= limit:
            break
        try:
            conn = _service_connection(directory)
        except AuthError as e:
            log.warning("ldap_directory_unavailable",
                        extra={"dir": directory.name, "err": str(e)})
            continue
        try:
            conn.search(
                search_base=directory.group_base,
                search_filter=ldap_filter,
                search_scope=SUBTREE,
                attributes=["objectGUID", "cn", "sAMAccountName", "description"],
                size_limit=limit,
            )
            for entry in conn.entries:
                try:
                    guid = _guid_to_str(entry.objectGUID.raw_values[0])
                except (AttributeError, IndexError, ValueError):
                    continue
                if guid in seen:
                    continue
                seen.add(guid)
                name = (
                    (entry.cn.value if entry.cn else None)
                    or (entry.sAMAccountName.value if entry.sAMAccountName else None)
                    or "Unknown"
                )
                desc = entry.description.value if entry.description else None
                results.append({"id": guid, "displayName": str(name), "description": desc})
                if len(results) >= limit:
                    break
        finally:
            try:
                conn.unbind()
            except Exception:  # noqa: BLE001
                pass
    return results
